# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/crm_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://dev644491_db_user:93oudRSmCx05Tkym@cluster0.mz9a8nj.mongodb.net/crm_sales

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use long random strings (32+ characters recommended)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Environment ───────────────────────────────────────────────────────────────
# development | production
# Set to "production" to enable: secure cookies, masked error messages
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave unset (or empty) to block all cross-origin requests (recommended in production).
ALLOWED_ORIGINS=http://localhost:3000
